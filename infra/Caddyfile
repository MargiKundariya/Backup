# Caddyfile — Automatic HTTPS via Let's Encrypt + HTTP/2
# Replace skinmockup.yourdomain.com with your actual domain.
#
# Usage:
#   caddy run --config infra/Caddyfile
#
# Caddy automatically obtains and renews TLS certificates.

skinmockup.yourdomain.com {
    # Forward all requests to Kong (Supabase API gateway)
    # Kong handles routing to GoTrue, PostgREST, Storage, etc.
    reverse_proxy 127.0.0.1:8000

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options     "nosniff"
        X-Frame-Options            "DENY"
        Referrer-Policy            "strict-origin-when-cross-origin"
        -Server
    }

    # Compress responses
    encode gzip
}
