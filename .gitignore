# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep examples, ignore secrets
.env
.env.local
.env.*.local
infra/.env

# infra persistent data (DB, storage) — never commit
infra/volumes/db/data/
infra/volumes/db/logs/
infra/volumes/storage/
infra/volumes/inbucket/
infra/volumes/functions/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
