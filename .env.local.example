# ─────────────────────────────────────────────────────────────────────────────
# Next.js .env.local — copy from infra/.env values after running:
#   cd infra && ./generate-secrets.sh
# ─────────────────────────────────────────────────────────────────────────────

# Public (exposed to browser) — Kong gateway
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from infra/.env>

# Server-only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from infra/.env>

# ── Stripe (Sprint 7) ─────────────────────────────────────────────────────────
# Create products + prices in Stripe Dashboard, then paste the Price IDs below.
# Use test keys (sk_test_...) in dev, live keys (sk_live_...) in production.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for each credit pack (create as one-time prices in Stripe Dashboard)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_BULK=price_...

# Recurring subscription prices (set billing_period=month in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
